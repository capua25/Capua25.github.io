---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import LogoM4 from "../img/M5.webp";
import mifoto from "../img/mifoto.png";
---

<Layout title="Martín Capuano - Developer">
	<div class="flex flex-col min-h-screen">
		<header class="sticky top-0 z-50 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-sm">
			<div class="container mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center justify-between h-16 border-b border-gray-200 dark:border-gray-800">
					<div class="flex items-center gap-4">
						<Image src={LogoM4} alt="Mi Logo" class="h-8 w-8"/>
						<h2 class="text-xl font-bold text-gray-900 dark:text-white">Martín Capuano</h2>
					</div>
					<nav class="hidden w-full md:flex items-center justify-center pr-32 gap-8">
						<a class="text-sm font-medium hover:text-accent-green transition-colors" href="#about">About</a>
						<a class="text-sm font-medium hover:text-accent-green transition-colors" href="#experience">Experience</a>
						<a class="text-sm font-medium hover:text-accent-green transition-colors" href="#skills">Skills</a>
						<a class="text-sm font-medium hover:text-accent-green transition-colors" href="#projects">Projects</a>
						<a class="text-sm font-medium hover:text-accent-green transition-colors" href="#contact">Contact</a>
					</nav>
					<div class="flex items-center gap-4">
						<div class="w-10 h-10 rounded-full bg-cover bg-center"
							style='background-image: url("");'
						>
						<Image src={mifoto} alt="Mi foto" class="rounded-full"></Image>
						</div>
						<button class="md:hidden p-2 rounded-md text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-800">
							<svg
								class="w-6 h-6"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M4 6h16M4 12h16m-7 6h7"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"></path>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</header>
		<main class="flex-grow">
			<section
				class="relative h-[60vh] min-h-[400px] flex items-center justify-center text-center text-white bg-cover bg-center"
				style='background-image: linear-gradient(rgba(17, 17, 33, 0.7), rgba(17, 17, 33, 0.9)), url("https://politica.uruguay30.com/wp-content/uploads/2021/07/Carmelo-vista-aerea.jpg");'
			>
				<div class="max-w-4xl px-4">
					<h1 class="text-4xl sm:text-5xl md:text-6xl font-bold">
						Martín Capuano
					</h1>
					<p
						class="mt-4 text-lg sm:text-xl md:text-2xl max-w-2xl mx-auto"
					>
						Software Developer with experience in DevOps and Web
						development using modern and well-established
						technologies.
					</p>
					<div
						class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4"
					>
						<a
							class="inline-block border-2 border-accent-green bg-accent-green text-background-dark font-bold py-3 px-8 rounded-lg hover:bg-accent-green/90 transition-transform transform hover:scale-105"
							href="#projects">View Projects</a
						>
						<a
							class="inline-flex items-center gap-2 bg-transparent border-2 border-accent-green text-accent-green font-bold py-3 px-8 rounded-lg hover:bg-accent-green hover:text-background-dark transition-all transform hover:scale-105"
							href="#"
						>
							<svg
								class="w-5 h-5"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"></path>
								<path
									d="M7 11l5 5 5-5"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"></path>
								<path
									d="M12 4v12"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"></path>
							</svg>
							Download Resume
						</a>
					</div>
				</div>
			</section>
			<div
				class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-24"
			>
				<section id="about">
					<div class="max-w-3xl mx-auto text-center">
						<h2
							class="text-3xl font-bold text-gray-900 dark:text-white"
						>
							About Me
						</h2>
						<p
							class="mt-6 text-lg text-gray-600 dark:text-gray-300"
						>
							I am a software developer with experience in <b class="text-accent-green">DevOps</b> environments, 
							specialized in using <b class="text-accent-green">WinDev</b> for
							enterprise solutions and with a strong background in
							<b class="text-accent-green">full-stack</b> web development using technologies
							like <b class="text-accent-green">JavaScript</b> and <b class="text-accent-green">node.js</b> with frameworks
							like <b class="text-accent-green">Astro</b>. I combine expertise in continuous
							integration, automation, and deployment with a focus
							on <b class="text-accent-green">efficiency</b>, code <b class="text-accent-green">quality</b>, and
							continuous <b class="text-accent-green">improvement</b> of development processes.
						</p>
					</div>
				</section>
				<section id="experience">
					<div class="max-w-5xl mx-auto">
						<h2
							class="text-3xl font-bold text-center text-gray-900 dark:text-white"
						>
							Work Experience
						</h2>
						<div class="mt-12 grid md:grid-cols-2 gap-12">
							<div
								class="relative pl-8 border-l-2 border-accent-green/20"
							>
								<div
									class="absolute -left-1.5 top-0 w-3 h-3 rounded-full bg-accent-green"
								>
								</div>
								<div class="flex items-center justify-between">
									<h3
										class="text-xl font-bold text-gray-900 dark:text-white"
									>
										Software Developer
									</h3>
									<p
										class="text-sm text-gray-500 dark:text-gray-400"
									>
										Jun 2023 - Present
									</p>
								</div>
								<p
									class="text-md font-medium text-accent-green mt-1"
								>
									Eurogen SRL - B&V Importaciones SRL
								</p>
								<ul
									class="mt-4 list-disc list-inside space-y-2 text-gray-600 dark:text-gray-300"
								>
									<li>
										Designed and developed desktop
										applications for enterprise using
										PCSoft's Windev and its native
										relational database HFSQL.
									</li>
									<li>
										Worked on maintenance of legacy
										software, patching errors and performing
										updates and improvements.
									</li>
									<li>
										Provided technical support and
										troubleshooting for existing
										applications.
									</li>
									<li>
										Participated in the full software
										development lifecycle from conception to
										deployment.
									</li>
									<li>
										Built and managed enterprise server with
										linux, focused on performance and
										security.
									</li>
								</ul>
							</div>
							<div
								class="relative pl-8 border-l-2 border-accent-green/20"
							>
								<div
									class="absolute -left-1.5 top-0 w-3 h-3 rounded-full bg-accent-green"
								>
								</div>
								<div class="flex items-center justify-between">
									<h3
										class="text-xl font-bold text-gray-900 dark:text-white"
									>
										Fullstack Web Developer
									</h3>
									<p
										class="text-sm text-gray-500 dark:text-gray-400"
									>
										Jan 2023 - Present
									</p>
								</div>
								<p
									class="text-md font-medium text-accent-green mt-1"
								>
									Freelance
								</p>
								<ul
									class="mt-4 list-disc list-inside space-y-2 text-gray-600 dark:text-gray-300"
								>
									<li>
										Developed and maintained web
										applications using JavaScript, Astro,
										Tailwind, and Node.js.
									</li>
									<li>
										Collaborated with cross-functional teams
										to define, design, and ship new
										features.
									</li>
									<li>
										Implemented responsive UIs with a focus
										on user experience and performance.
									</li>
									<li>
										Collaborated in existing projects with
										technologies such as PHP or Python.
									</li>
								</ul>
							</div>
						</div>
					</div>
				</section>
				<section id="skills">
					<div class="max-w-4xl mx-auto text-center">
						<h2
							class="text-3xl font-bold text-gray-900 dark:text-white"
						>
							Skills
						</h2>
						<div class="mt-8 flex flex-wrap justify-center gap-4">
							<span
								class="bg-accent-green/10 text-accent-green font-medium py-2 px-4 rounded-full"
								>Windev</span
							>
							<span
								class="bg-accent-green/10 text-accent-green font-medium py-2 px-4 rounded-full"
								>JavaScript</span
							>
							<span
								class="bg-accent-green/10 text-accent-green font-medium py-2 px-4 rounded-full"
								>Node.js</span
							>
							<span
								class="bg-accent-green/10 text-accent-green font-medium py-2 px-4 rounded-full"
								>Astro</span
							>
							<span
								class="bg-accent-green/10 text-accent-green font-medium py-2 px-4 rounded-full"
								>Linux</span
							>
							<span
								class="bg-accent-green/10 text-accent-green font-medium py-2 px-4 rounded-full"
								>SQL</span
							>
							<span
								class="bg-accent-green/10 text-accent-green font-medium py-2 px-4 rounded-full"
								>Python</span
							>
							<span
								class="bg-accent-green/10 text-accent-green font-medium py-2 px-4 rounded-full"
								>PHP</span
							>
						</div>
					</div>
				</section>
				<section id="projects">
					<div class="max-w-5xl mx-auto">
						<h2
							class="text-3xl font-bold text-center text-gray-900 dark:text-white"
						>
							Projects
						</h2>
						<div class="mt-12 grid gap-12 md:grid-cols-2">
							<div
								class="bg-white dark:bg-gray-800/20 rounded-lg shadow-lg overflow-hidden group border border-transparent hover:border-accent-green transition-all duration-300"
							>
								<div class="relative">
									<img
										alt="E-commerce Platform"
										class="w-full h-56 object-cover"
										src="https://lh3.googleusercontent.com/aida-public/AB6AXuCof2j6PBHfFhqZQasFxPc4DhaFu7uY5Owt0ofjaH1z0rFx8UcAECOOfaUSgVSMS8RwqoTnJcFCcPyWn9y6goQNF_pOQvH1Rd0w9xokYgeSr_q-RdB1Vc-SbbM-ArBXNuz25EZ2Tff2i0KUsE0KRohBUcfQpBGr4I5WSC9w8Nn1IzwV4jBydiSjIOV7w_QN2sX1R45tFUX4QxPGc_s0gkpZeu-hicLsezXDG37o6WXvf1sZPwgRGzBL-HC8WphhO4aJAHGbUlXooaQ"
									/>
									<div
										class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-all duration-300"
									>
									</div>
								</div>
								<div class="p-6">
									<p
										class="text-sm font-semibold text-accent-green"
									>
										Featured Project
									</p>
									<h3
										class="mt-2 text-xl font-bold text-gray-900 dark:text-white"
									>
										E-commerce Platform
									</h3>
									<p
										class="mt-2 text-gray-600 dark:text-gray-300"
									>
										A comprehensive e-commerce platform
										built with React, Node.js, and SQL,
										featuring user authentication, product
										management, and a secure checkout
										process.
									</p>
									<div class="mt-4 flex gap-4">
										<a
											class="inline-block bg-accent-green text-background-dark text-sm font-bold py-2 px-4 rounded hover:bg-accent-green/90 transition-colors"
											href="#">View Project</a
										>
										<a
											class="inline-block bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm font-bold py-2 px-4 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
											href="#">GitHub</a
										>
									</div>
								</div>
							</div>
							<div
								class="bg-white dark:bg-gray-800/20 rounded-lg shadow-lg overflow-hidden group border border-transparent hover:border-accent-green transition-all duration-300"
							>
								<div class="relative">
									<img
										alt="Portfolio Website"
										class="w-full h-56 object-cover"
										src="https://lh3.googleusercontent.com/aida-public/AB6AXuCJvqgBgcWA9-XcFu1E-gdk3Pg3KeG1QelaoySWDvbwYnTLUM8WLbnMOkhrau9boSFXeUx9lWgcjJEAIT7Ytis47pifkMpZF2FUdHtNrDhw0I6gvOCra68T001TIQ3Jl8ugjG9bHIrNmxM21zZ2sTtclQ6k7vvSjmAFeQ6TCtlgDP2IxBBI_NAXavexqYgp4fuuDP5eT2_6fIx2d-WhW6blEPhHYFFCS-oTq1BFndyQIX0is0SPUxTOJ3NvObMbTjyd_hJrn5a9mZ8"
									/>
									<div
										class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-all duration-300"
									>
									</div>
								</div>
								<div class="p-6">
									<p
										class="text-sm font-semibold text-accent-green"
									>
										Featured Project
									</p>
									<h3
										class="mt-2 text-xl font-bold text-gray-900 dark:text-white"
									>
										Portfolio Website
									</h3>
									<p
										class="mt-2 text-gray-600 dark:text-gray-300"
									>
										A personal portfolio website developed
										using Astro, showcasing projects,
										skills, and contact information in a
										clean and responsive design.
									</p>
									<div class="mt-4 flex gap-4">
										<a
											class="inline-block bg-accent-green text-background-dark text-sm font-bold py-2 px-4 rounded hover:bg-accent-green/90 transition-colors"
											href="#">View Project</a
										>
										<a
											class="inline-block bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm font-bold py-2 px-4 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
											href="#">GitHub</a
										>
									</div>
								</div>
							</div>
						</div>
					</div>
				</section>
				<section id="contact">
					<div class="max-w-2xl mx-auto">
						<h2
							class="text-3xl font-bold text-center text-gray-900 dark:text-white"
						>
							Contact Me
						</h2>
						<form class="mt-12 space-y-6">
							<div>
								<label
									class="block text-sm font-medium text-gray-700 dark:text-gray-300"
									for="name">Name</label
								>
								<input
									class="mt-1 block w-full px-4 py-3 bg-white dark:bg-gray-800/20 border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-accent-green focus:border-accent-green"
									id="name"
									name="name"
									placeholder="Your Name"
									type="text"
								/>
							</div>
							<div>
								<label
									class="block text-sm font-medium text-gray-700 dark:text-gray-300"
									for="email">Email</label
								>
								<input
									class="mt-1 block w-full px-4 py-3 bg-white dark:bg-gray-800/20 border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-accent-green focus:border-accent-green"
									id="email"
									name="email"
									placeholder="Your Email"
									type="email"
								/>
							</div>
							<div>
								<label
									class="block text-sm font-medium text-gray-700 dark:text-gray-300"
									for="message">Message</label
								>
								<textarea
									class="mt-1 block w-full px-4 py-3 bg-white dark:bg-gray-800/20 border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-accent-green focus:border-accent-green"
									id="message"
									name="message"
									placeholder="Your Message"
									rows="4"></textarea>
							</div>
							<div class="text-center">
								<button
									class="inline-block bg-accent-green text-background-dark font-bold py-3 px-8 rounded-lg hover:bg-accent-green/90 transition-colors"
									type="submit">Send Message</button
								>
							</div>
						</form>
					</div>
				</section>
			</div>
		</main>
		<footer
			class="bg-background-light dark:bg-background-dark border-t border-gray-200 dark:border-gray-800"
		>
			<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
				<div
					class="flex flex-col md:flex-row items-center justify-between gap-6"
				>
					<div class="flex gap-6">
						<a
							class="text-gray-500 dark:text-gray-400 hover:text-accent-green"
							href="#"
						>
							<svg
								aria-hidden="true"
								class="h-6 w-6"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									clip-rule="evenodd"
									d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014V8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.337 7.433a1.144 1.144 0 01-1.144-1.144c0-.63.513-1.144 1.144-1.144.63 0 1.144.513 1.144 1.144 0 .63-.513 1.144-1.144 1.144zM6.602 16.338H4.074V8.59h2.528v7.748zM18.338 2.016H1.662C.746 2.016 0 2.762 0 3.678v16.644C0 21.238.746 22 1.662 22h16.676c.916 0 1.662-.762 1.662-1.678V3.678c0-.916-.746-1.662-1.662-1.662z"
									fill-rule="evenodd"></path>
							</svg>
						</a>
						<a
							class="text-gray-500 dark:text-gray-400 hover:text-accent-green"
							href="#"
						>
							<svg
								aria-hidden="true"
								class="h-6 w-6"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									clip-rule="evenodd"
									d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.165 6.839 9.491.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.031-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.03 1.595 1.03 2.688 0 3.848-2.338 4.695-4.566 4.942.359.308.678.92.678 1.852 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z"
									fill-rule="evenodd"></path>
							</svg>
						</a>
					</div>
					<p class="text-sm text-gray-500 dark:text-gray-400">
						© 2025 Martín Capuano. All rights reserved.
					</p>
				</div>
			</div>
		</footer>
	</div>
</Layout>

<style></style>
