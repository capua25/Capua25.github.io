---

---

<section id="contact">
    <div class="max-w-2xl mx-auto">
        <h2
            class="text-3xl font-bold text-center text-gray-900 dark:text-white"
        >
            Contact Me
        </h2>
        <form class="mt-12 space-y-6">
            <div>
                <label
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                    for="name">Name</label
                >
                <input
                    class="mt-1 block w-full px-4 py-3 bg-white dark:bg-gray-800/20 border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-accent-green focus:border-accent-green"
                    id="name"
                    name="name"
                    placeholder="Your Name"
                    type="text"
                />
            </div>
            <div>
                <label
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                    for="email">Email</label
                >
                <input
                    class="mt-1 block w-full px-4 py-3 bg-white dark:bg-gray-800/20 border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-accent-green focus:border-accent-green"
                    id="email"
                    name="email"
                    placeholder="Your Email"
                    type="email"
                />
            </div>
            <div>
                <label
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                    for="message">Message</label
                >
                <textarea
                    class="mt-1 block w-full px-4 py-3 bg-white dark:bg-gray-800/20 border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-accent-green focus:border-accent-green"
                    id="message"
                    name="message"
                    placeholder="Your Message"
                    rows="4"></textarea>
            </div>
            <div class="text-center">
                <button
                    class="inline-block bg-accent-green text-background-dark font-bold py-3 px-8 rounded-lg hover:bg-accent-green/90 transition-colors"
                    type="submit">Send Message</button
                >
            </div>
        </form>
    </div>
</section>