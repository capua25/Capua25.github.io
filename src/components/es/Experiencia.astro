<section id="experience">
    <div class="max-w-5xl mx-auto">
        <h2
            class="text-3xl font-bold text-center text-gray-900 dark:text-white"
        >
            Work Experience
        </h2>
        <div class="mt-12 grid md:grid-cols-2 gap-12">
            <div
                class="relative pl-8 border-l-2 border-accent-green/20"
            >
                <div
                    class="absolute -left-1.5 top-0 w-3 h-3 rounded-full bg-accent-green"
                >
                </div>
                <div class="flex items-center justify-between">
                    <h3
                        class="text-xl font-bold text-gray-900 dark:text-white"
                    >
                        Software Developer
                    </h3>
                    <p
                        class="text-sm text-gray-500 dark:text-gray-400"
                    >
                        Jun 2023 - Present
                    </p>
                </div>
                <p
                    class="text-md font-medium text-accent-green mt-1"
                >
                    Eurogen SRL - B&V Importaciones SRL
                </p>
                <ul
                    class="mt-4 list-disc list-inside space-y-2 text-gray-600 dark:text-gray-300"
                >
                    <li>
                        Designed and developed desktop
                        applications for enterprise using
                        PCSoft's Windev and its native
                        relational database HFSQL.
                    </li>
                    <li>
                        Worked on maintenance of legacy
                        software, patching errors and performing
                        updates and improvements.
                    </li>
                    <li>
                        Provided technical support and
                        troubleshooting for existing
                        applications.
                    </li>
                    <li>
                        Participated in the full software
                        development lifecycle from conception to
                        deployment.
                    </li>
                    <li>
                        Built and managed enterprise server with
                        linux, focused on performance and
                        security.
                    </li>
                </ul>
            </div>
            <div
                class="relative pl-8 border-l-2 border-accent-green/20"
            >
                <div
                    class="absolute -left-1.5 top-0 w-3 h-3 rounded-full bg-accent-green"
                >
                </div>
                <div class="flex items-center justify-between">
                    <h3
                        class="text-xl font-bold text-gray-900 dark:text-white"
                    >
                        Fullstack Web Developer
                    </h3>
                    <p
                        class="text-sm text-gray-500 dark:text-gray-400"
                    >
                        Jan 2023 - Present
                    </p>
                </div>
                <p
                    class="text-md font-medium text-accent-green mt-1"
                >
                    Freelance
                </p>
                <ul
                    class="mt-4 list-disc list-inside space-y-2 text-gray-600 dark:text-gray-300"
                >
                    <li>
                        Developed and maintained web
                        applications using JavaScript, Astro,
                        Tailwind, and Node.js.
                    </li>
                    <li>
                        Collaborated with cross-functional teams
                        to define, design, and ship new
                        features.
                    </li>
                    <li>
                        Implemented responsive UIs with a focus
                        on user experience and performance.
                    </li>
                    <li>
                        Collaborated in existing projects with
                        technologies such as PHP or Python.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>