---
import { Image } from 'astro:assets';
import LogoM4 from "../img/M5.png";
import mifoto from "../img/mifoto.png";

import LangSelect from "../components/LenguajeSelect.astro";

import { useTranslation } from '../i18n/utils';
import { labels } from '../i18n/ui';

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<header class="sticky top-0 z-50 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-sm">
    <div class="container box-content mx-auto px-4 sm:px-6 lg:px-8 min-h-36 sm:min-h-16">
        <div class="flex items-center flex-col sm:flex-row justify-evenly sm:justify-between min-h-36 sm:min-h-16 border-b border-gray-200 dark:border-gray-800 w-full">
            <div class="flex items-center justify-center gap-4 mb-2 sm:mb-0">
                <Image src={LogoM4} alt="Mi Logo" class="h-8 w-8"/>
                <h2 class="text-xl text-center min-w-48 font-bold text-gray-900 dark:text-white">Martín Capuano</h2>
            </div>
            <nav class="hidden w-full lg:flex items-center justify-center gap-8">
                <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#about">{translated('nav.about')}</a>
                <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#experience">{translated('nav.experience')}</a>
                <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#skills">{translated('nav.skills')}</a>
                <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#projects">{translated('nav.projects')}</a>
                <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#contact">{translated('nav.contact')}</a>
            </nav>
            <div class="flex items-center justify-center w-full sm:w-16 gap-8 mb-2">
                <div class="w-10 h-10 rounded-full bg-cover bg-center"
                    style={`background-image: url(${mifoto.src});`}
                >
                </div>
                <button id="burger" class="lg:hidden p-2 rounded-md text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-800">
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M4 6h16M4 12h16m-7 6h7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"></path>
                    </svg>
                </button>
            </div>
            <div id="menu" class="hidden sm:hidden transition-all">
                <nav class="w-full flex flex-col items-center justify-center gap-2 my-2">
                    <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#about">{translated('nav.about')}</a>
                    <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#experience">{translated('nav.experience')}</a>
                    <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#skills">{translated('nav.skills')}</a>
                    <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#projects">{translated('nav.projects')}</a>
                    <a class="text-sm font-medium hover:text-accent-green transition-colors" href="#contact">{translated('nav.contact')}</a>
                </nav>
            </div>
            <LangSelect></LangSelect>
        </div>
    </div>
</header>

<script>
    const burger = document.getElementById('burger');
    const menu = document.getElementById('menu');

    burger.addEventListener('click', () => {
        if (menu.classList.contains('hidden')) {
            menu.classList.remove('hidden');
            menu.classList.add('flex');
        } else {
            menu.classList.remove('flex');
            menu.classList.add('hidden');
        }
    });
</script>