---
import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<section
  class="relative h-[60vh] min-h-[400px] flex items-center justify-center text-center text-white bg-cover bg-center"
  style='background-image: linear-gradient(rgba(17, 17, 33, 0.7), rgba(17, 17, 33, 0.9)), url("https://politica.uruguay30.com/wp-content/uploads/2021/07/Carmelo-vista-aerea.jpg");'
>
  <div class="max-w-4xl px-4">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold">Martín Capuano</h1>
    <p class="mt-4 text-lg sm:text-xl md:text-2xl max-w-2xl mx-auto">
      {translated("landing.text")}
    </p>
    <div
      class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4"
    >
      <a
        class="inline-block border-2 border-accent-green bg-accent-green text-background-dark font-bold py-3 px-8 rounded-lg hover:bg-accent-green/90 transition-transform transform hover:scale-105"
        href="#projects">{translated("landing.button1")}</a
      >
      <a
        class="inline-flex items-center gap-2 bg-transparent border-2 border-accent-green text-accent-green font-bold py-3 px-8 rounded-lg hover:bg-accent-green hover:text-background-dark transition-all transform hover:scale-105"
        href="#"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
          <path
            d="M7 11l5 5 5-5"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
          <path
            d="M12 4v12"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
        </svg>
        {translated("landing.button2")}
      </a>
    </div>
  </div>
</section>
