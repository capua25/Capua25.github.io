---
import { Image } from "astro:assets";
import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";
import Eurogen from "../img/proyectos/eurogen.png";
import Rustico from "../img/proyectos/rustico.png";
import Sonora from "../img/proyectos/sonora.png";

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<section id="projects">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white">
      {translated("pj.title")}
    </h2>
    <div class="mt-12 grid gap-12 md:grid-cols-2">
      <div class="bg-white dark:bg-gray-800/20 rounded-lg shadow-lg overflow-hidden group border border-transparent hover:border-accent-green transition-all duration-300">
        <div class="relative">
          <Image src={Eurogen} alt="Eurogen" class="w-full h-56 object-cover"></Image>
