        <div class="p-6">
          <h3 class="mt-2 text-xl font-bold text-accent-green">
            {translated("pj.p1name")}
          </h3>
          <p class="mt-2 text-gray-600 dark:text-gray-300">
            {translated("pj.p1text")}
          </p>
          <div class="mt-4 flex gap-4">
            <a class="inline-block bg-accent-green text-background-dark text-sm font-bold py-2 px-4 rounded hover:bg-accent-green/90 transition-colors" href="#">
              {translated("pj.button1")}
            </a>
          </div>
        </div>
      </div>
      <div class="bg-white dark:bg-gray-800/20 rounded-lg shadow-lg overflow-hidden group border border-transparent hover:border-accent-green transition-all duration-300">
