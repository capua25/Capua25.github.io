---
const { title,openID,closeID,modalID } = Astro.props;
---
<button id={openID} class="modal inline-block bg-accent-green text-background-dark text-sm font-bold py-2 px-4 rounded hover:bg-accent-green/90 transition-colors">
    {title}
</button>

<modal id={modalID} class="hidden fixed z-10 left-0 top-0 w-full h-full bg-black bg-opacity-60">
    <button id={closeID} class="fixed top-20 right-4 text-xl">X</button>
    <slot/>
</modal>

<script is:inline define:vars={{ openID,closeID,modalID }}>
    const modal = document.getElementById(modalID);
    const openBtn = document.getElementById(openID);
    const closeBtn = document.getElementById(closeID);
    
    openBtn.addEventListener('click', () => {
        modal.classList.remove('hidden');
    });

    closeBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
    });
    
    window.addEventListener('click', (event) => {
        if (event.target === modal) {
            modal.classList.add('hidden');
        }
    });

