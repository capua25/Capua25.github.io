---
const currentLang = Astro.currentLocale || "en";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/M5.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="author" content="Martín Capuano" />
		<meta name="keywords" content="Martín Capuano, Martín, Capuano, Portfolio, Developer, Web Developer, Full Stack Developer, JavaScript, TypeScript, Node.js, Astro, Windev, Uruguay" />
		<meta name="description" content="Martín Capuano's personal portfolio as software and web developer." />
		<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		<meta property="og:title" content="Martín Capuano - Software Developer" />
		<meta property="og:description" content="Martín Capuano's personal portfolio as software and web developer." />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/M5.webp" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Martín Capuano - Software Developer" />
		<meta name="twitter:description" content="Martín Capuano's personal portfolio as software and web developer." />
		<script is:inline>
			const theme = localStorage.getItem('theme') ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			document.documentElement.classList.toggle('dark', theme === 'dark');
		</script>
	</head>
	<body class="bg-gray-200 dark:bg-background-dark font-display text-gray-800 dark:text-gray-200">
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	@font-face {
		font-family: "JA";
		src: url("../fonts/SimplyMono-Book.ttf");
	}
	html {
		font-family: 'JA', system-ui, sans-serif;
	}
	body::-webkit-scrollbar{
		display: none;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
    .group:hover .group-hover\:block {
      display: block;
    }
</style>